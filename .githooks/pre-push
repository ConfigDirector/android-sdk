#!/usr/bin/env sh
#
# Runs the same checks CI runs, before allowing a push.
#
#   ./gradlew build  ->  the Java tests actually ran
#
# `build` covers the SDK's Kotlin, both of its test source sets, Android lint, and both sample
# apps -- the Java sample being a Java-only module, which is what catches a break in the SDK's
# Java surface.
#
# Install it with:  git config core.hooksPath .githooks
# Bypass it for a single push with:  git push --no-verify
#
# Note: this checks the working tree, not the commits being pushed. Uncommitted changes are
# included, which is usually what you want and occasionally surprising.

set -eu

# --- skip when the push only deletes remote refs -----------------------------------------
# git feeds "<local ref> <local sha> <remote ref> <remote sha>" per ref on stdin. A deletion
# has an all-zero local sha and nothing to check. Skip the read entirely when run from a
# terminal, so the hook stays runnable by hand.
if [ ! -t 0 ]; then
    saw_ref=0
    only_deletes=1
    while read -r _local_ref local_sha _remote_ref _remote_sha; do
        saw_ref=1
        case "$local_sha" in
            *[!0]*) only_deletes=0 ;;
        esac
    done
    if [ "$saw_ref" -eq 1 ] && [ "$only_deletes" -eq 1 ]; then
        echo "pre-push: deleting refs only, nothing to check."
        exit 0
    fi
fi

cd "$(git rev-parse --show-toplevel)"

# GUI git clients (Android Studio, VS Code, Fork, Tower) often start without the shell profile, so
# a JDK installed through SDKMAN or Homebrew may not be on PATH even though Gradle finds it fine
# from a terminal.
if ! command -v java >/dev/null 2>&1 && [ -n "${JAVA_HOME:-}" ]; then
    PATH="$JAVA_HOME/bin:$PATH"
    export PATH
fi

if ! command -v java >/dev/null 2>&1; then
    echo "pre-push: no 'java' on PATH, and JAVA_HOME is unset." >&2
    echo "  Gradle needs a JDK 17 or newer to run the Android Gradle plugin." >&2
    echo "  Or bypass with: git push --no-verify" >&2
    exit 1
fi

# The Android SDK is found through local.properties or ANDROID_HOME. Without either, the build
# fails several minutes in with a message about a missing SDK location.
if [ ! -f local.properties ] && [ -z "${ANDROID_HOME:-}" ] && [ -z "${ANDROID_SDK_ROOT:-}" ]; then
    echo "pre-push: the Android SDK location is not set." >&2
    echo "  Write it to local.properties:  echo \"sdk.dir=\$HOME/Library/Android/sdk\" > local.properties" >&2
    echo "  or export ANDROID_HOME. Opening the project in Android Studio does this for you." >&2
    echo "  Or bypass with: git push --no-verify" >&2
    exit 1
fi

if [ -t 1 ]; then
    bold=$(printf '\033[1m')
    red=$(printf '\033[31m')
    green=$(printf '\033[32m')
    reset=$(printf '\033[0m')
else
    bold='' red='' green='' reset=''
fi

run() {
    label=$1
    shift
    printf '\n%s> %s%s\n' "$bold" "$label" "$reset"
    if ! "$@"; then
        printf '\n%spre-push failed at: %s%s\n' "$red" "$label" "$reset" >&2
        printf '  Fix the failure, or bypass with: git push --no-verify\n' >&2
        exit 1
    fi
}

run "./gradlew build" ./gradlew build

# A build can go green with the Java tests silently not running at all, which would leave the
# Java surface uncovered. CI runs this same script.
run "the Java tests ran" ./.github/scripts/check-java-tests-ran.sh

printf '\n%spre-push checks passed%s\n' "$green" "$reset"
